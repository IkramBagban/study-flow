// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  emailVerified Boolean?
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      Session[]
  accounts      Account[]
  courses       Course[]
  quizAttempts  QuizAttempt[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Course {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  subject     String
  goal        String
  level       String
  modules     Module[]
  flashcards  Flashcard[]
  quizzes     Quiz[]
  resources   Resource[]

  status         String @default("DRAFT") // DRAFT, GENERATING, READY
  assessmentData Json? // Stores concept check results and quiz scores
  sourceData     Json? // Stores source text, URLs, etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("course")
}

model Module {
  id       String    @id @default(cuid())
  courseId String
  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  order    Int
  chapters Chapter[]

  description String? // "Why this group exists"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("module")
}

model Chapter {
  id       String @id @default(cuid())
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title    String
  order    Int

  estimatedTime String?

  concepts   Concept[]
  flashcards Flashcard[]
  quizzes    Quiz[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("chapter")
}

model Concept {
  id        String  @id @default(cuid())
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title     String
  order     Int

  type       String // "priming", "core", "application"
  isReady    Boolean     @default(false)
  content    Json? // Stores hook, explanation, examples (structured)
  flashcards Flashcard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("concept")
}

model Flashcard {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  conceptId String?
  concept   Concept? @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  front       String
  back        String
  explanation String?
  type        String  @default("basic") // basic, code, math

  // FSRS (Free Spaced Repetition Scheduler) State
  due           DateTime  @default(now()) // When the card is next due for review
  stability     Float     @default(0) // Memory stability (higher = more stable)
  difficulty    Float     @default(0) // Card difficulty (0-1 scale, higher = harder)
  elapsedDays   Int       @default(0) // Days since last review
  scheduledDays Int       @default(0) // Scheduled interval in days
  reps          Int       @default(0) // Total number of reviews
  lapses        Int       @default(0) // Number of times forgotten (rated Again)
  state         Int       @default(0) // 0=New, 1=Learning, 2=Review, 3=Relearning
  lastReview    DateTime? // Last review timestamp

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, due])
  @@map("flashcard")
}

model Quiz {
  id        String   @id @default(cuid())
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  title     String
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("quiz")
}

model QuizQuestion {
  id     String @id @default(cuid())
  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  question    String
  explanation String?
  options     QuizOption[]

  order Int

  @@map("quiz_question")
}

model QuizOption {
  id         String       @id @default(cuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  text      String
  isCorrect Boolean

  @@map("quiz_option")
}

model QuizAttempt {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  score    Float
  feedback String? @db.Text // AI Feedback

  // Storing detailed answers as JSON since it's just for history/review
  // structure: { questionId: string, optionId: string, isCorrect: boolean }[]
  answers Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("quiz_attempt")
}

model Resource {
  id       String  @id @default(cuid())
  courseId String
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  content  String  @db.Text
  type     String // "pdf", "text", "url"
  fileName String?

  embeddings Embedding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("resource")
}

model Embedding {
  id         String                 @id @default(uuid())
  resourceId String
  resource   Resource               @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  content    String                 @db.Text
  vector     Unsupported("vector")?

  createdAt DateTime @default(now())

  @@map("embedding")
}
